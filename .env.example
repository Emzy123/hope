# ==============================================================================
# SkillBridge Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Do NOT commit your local '.env' file to version control!

# --- Django Core Settings ---
SECRET_KEY=django-insecure-your-super-secret-key-change-this-in-production
DEBUG=True
# A secret passphrase required in addition to email+password for admin login.
# Must be set in production. Keep this value private and never commit it.
ADMIN_SECRET_PHRASE=your-admin-secret-phrase-here
ENVIRONMENT=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,skillbridge-backend.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://skillbridge-frontend.vercel.app

# --- MongoDB Database Settings ---
# MongoDB Atlas Connection URI (M0 Free Tier)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/skillbridge?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/skillbridge

# --- Paystack Payment Gateway Settings (Sandbox for development) ---
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# The payload verification token or standard Paystack webhook HMAC key is same as PAYSTACK_SECRET_KEY

# --- Termii OTP / SMS Settings ---
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=your_termii_sender_id
TERMII_BASE_URL=https://api.ng.termii.com

# --- Cloudinary CDN Media Storage Settings ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- JWT Configuration ---
# Cookie configuration for SimpleJWT
JWT_COOKIE_SECURE=False

# --- SMTP / Email Settings ---
# For Gmail, set EMAIL_HOST=smtp.gmail.com and use a 16-character Google App Password (not your account password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
